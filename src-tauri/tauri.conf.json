{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccessibleScreenCapture",
  "version": "2.1.0-1",
  "identifier": "org.opendoordesign.accessiblescreencapture",
  "build": {
    "beforeDevCommand": "node scripts/prepare-dist.js",
    "beforeBuildCommand": "node scripts/prepare-dist.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AccessibleScreenCapture - Open Door Design",
        "label": "main",
        "width": 900,
        "height": 900,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "AccessibleScreenCapture"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "Open Door Design",
    "copyright": "Copyright © 2026 Open Door Design",
    "category": "Utility",
    "shortDescription": "Accessible screen capture for Windows.",
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "longDescription": "Screenshot and screen recording tool designed from the ground up for keyboard and screen reader users, with native system audio capture.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": [
      "resources/foundry-local/*"
    ]
  }
}
