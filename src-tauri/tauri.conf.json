{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccessibleScreenCapture Pro",
  "version": "3.0.0-7",
  "identifier": "org.opendoordesign.accessiblescreencapture",
  "build": {
    "beforeDevCommand": "node scripts/prepare-dist.js",
    "beforeBuildCommand": "node scripts/prepare-dist.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AccessibleScreenCapture Pro - Open Door Design",
        "label": "main",
        "width": 900,
        "height": 900,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/pending-captures/**/*"
        ]
      }
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "AccessibleScreenCapture Pro"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "Open Door Design",
    "copyright": "Copyright \u00a9 2026 Open Door Design",
    "category": "Utility",
    "shortDescription": "Accessible screen capture for Windows.",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/llama-server"
    ],
    "longDescription": "Screenshot and screen recording tool designed from the ground up for keyboard and screen reader users, with native system audio capture.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "binaries/*.dll": "."
    }
  }
}
